# ARTHA configuration. Copy to .env and adjust.
ARTHA_ENV=dev

# Operational store. Postgres in any real deployment; SQLite only for the local demo.
ARTHA_DATABASE_URL=sqlite:///./artha.db

# Tokenisation vault. MUST be replaced in any deployment holding real data.
ARTHA_VAULT_SECRET=dev-only-insecure-secret-replace-me

# Financial Twin
ARTHA_TWIN_HORIZON_DAYS=180
ARTHA_TWIN_PATHS=2000
ARTHA_TWIN_SEED=20260912

# Suitability Gate
ARTHA_NUDGE_BUDGET_PER_MONTH=4
ARTHA_PRODUCT_COOLDOWN_DAYS=45
ARTHA_MIN_BUFFER_DAYS=21
ARTHA_BREACH_PROBABILITY_CEILING=0.10
ARTHA_OBLIGATION_TO_INCOME_CEILING=0.50

# Banker console capacity — precision is evaluated at this N.
ARTHA_DAILY_CONTACT_CAPACITY=150

# Language services. Adapters are stubbed offline by default; point these at an
# in-country Bhashini deployment to go live (report §9.2).
ARTHA_LANGUAGE_PROVIDER=stub
ARTHA_BHASHINI_ENDPOINT=
ARTHA_BHASHINI_API_KEY=
